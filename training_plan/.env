VLA_STORAGE_ROOT=/data
STAFF1_DATASET_ROOT=/data/datasets/b2_z1/training/staff1
ALL_SCENES_DATASET_ROOT=/data/datasets/b2_z1/training/all_scenes
BASE_POLICY=/data/checkpoints/lerobot_pi05_base_local_tokenizer
MEM_VIT_CHECKPOINT=/data/checkpoints/mem_vit_distill_20260716_142702/mem_vit_distill_latest.pt
OUTPUT_ROOT=/data/models/trained/pi05
WANDB_PROJECT=b2-z1-vla

TRAIN_STEPS=100000
GLOBAL_BATCH_SIZE=48
BATCH_SIZE_PER_GPU=2
EVAL_STEPS=500
PHYSICAL_EVAL_SAMPLES=96
SAVE_FREQ=500
KEEP_LAST_CHECKPOINTS=2
KEEP_CHECKPOINT_EVERY_N_STEPS=10000

B2_ACTION_REPRESENTATION=pose_delta
Z1_ACTION_REPRESENTATION=ee_state_delta
ACTION_SEMANTICS_PROFILE=joint_control_arm_mode_v2
ACTION_LOSS_SCHEMA=group_balanced
PREDICT_TASK_COMPLETE=true
PREDICT_TASK_BLOCKED=false
INTERIOR_STATIC_WEIGHT=0.0
TERMINAL_STATIC_WEIGHT=1.0

MEM_RANDOM_MIN_NUM_FRAMES=1
MEM_RANDOM_MAX_NUM_FRAMES=6
MEM_FRAME_INTERVAL_SECONDS=0.5
MEM_RANDOM_INTERVAL_SAMPLING=true
MEM_GLOBAL_INTERVAL_STD_SECONDS=0.15
MEM_LOCAL_INTERVAL_STD_SECONDS=0.05
MEM_MIN_INTERVAL_SECONDS=0.25
MEM_MAX_INTERVAL_SECONDS=1.0

# Remote cluster orchestration. These are user-facing deployment settings;
# training_plan/cluster.sh contains no machine-specific hidden defaults.
CLUSTER_SSH_CONFIG=/home/yangfeihong/workspace/data_postprocessing/deployment/ssh/config
CLUSTER_SSH_CONTROL_PATH=/tmp/vla-training-cluster-%C
CLUSTER_CONTAINER_NAME=vla-training-plan
CLUSTER_IMAGE_BWLIMIT_KB=5120
CLUSTER_LOCAL_CHECKPOINT_ROOT=/data01/yangfeihong/MEM_videos/models/trained/pi05
CLUSTER_F_MIN_FREE_GIB=600
CLUSTER_F_TARGET_FREE_GIB=700

CLUSTER_CU124_IMAGE_ARCHIVE=/data01/yangfeihong/docker_images/lerobot-gpu_cu124.tar.gz
CLUSTER_F_IMAGE_ARCHIVE=/data01/yangfeihong/docker_images/lerobot-gpu_latest.tar.gz

CLUSTER_F_SSH_HOST=wholebody_F
